{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "dependencyDashboardTitle": "SlackBuilds - Upstream Updates",
  "automerge": false,
  "ignoreUnstable": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/!(ungoogled-chromium-bin).info"
      ],
      "matchStrings": [
        "VERSION=\"(?<currentValue>[^\"]+)\"\\s+HOMEPAGE=\"[^\"]*\"\\s+DOWNLOAD=\"https://github\\.com/(?<depName>[^/\\s\"]+/[^/\\s\"]+)",
        "VERSION=\"(?<currentValue>[^\"]+)\"\\s+HOMEPAGE=\"[^\"]*\"\\s+DOWNLOAD=\"UNSUPPORTED\"\\s+MD5SUM=\"[^\"]*\"\\s+DOWNLOAD_x86_64=\"https://github\\.com/(?<depName>[^/\\s\"]+/[^/\\s\"]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/system\\/ungoogled-chromium-bin\\/ungoogled-chromium-bin\\.info$/"
      ],
      "matchStrings": [
        "VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)_\\d+\""
      ],
      "depNameTemplate": "ungoogled-software/ungoogled-chromium-portablelinux",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)-\\d+$",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ryanoasis/nerd-fonts"
      ],
      "groupName": "Nerd Fonts"
    }
  ]
}
